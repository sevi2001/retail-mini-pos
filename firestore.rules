
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Check authentication
    function signedIn() {
      return request.auth != null;
    }

    // Check Manager role
    function isManager() {
      return signedIn()
        && request.auth.token.manager == true;
    }

    // Check Cashier role
    function isCashier() {
      return signedIn()
        && request.auth.token.cashier == true;
    }

    // Allow only authorized staff
    function isStaff() {
      return isManager() || isCashier();
    }

    // Validate product data
    function validProduct(data, productId) {
      return data.keys().hasAll([
        'sku',
        'name',
        'category',
        'unit',
        'costPrice',
        'sellingPrice',
        'stockQty',
        'isActive',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'sku',
        'name',
        'category',
        'unit',
        'costPrice',
        'sellingPrice',
        'stockQty',
        'isActive',
        'updatedAt'
      ])
      && data.sku is string
      && data.sku == productId
      && data.sku.matches('^[A-Z0-9_-]{2,40}$')
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 120
      && data.category is string
      && data.category.size() > 0
      && data.category.size() <= 60
      && data.unit in ['pcs', 'kg', 'g', 'L']
      && data.costPrice is number
      && data.costPrice >= 0
      && data.sellingPrice is number
      && data.sellingPrice >= 0
      && data.stockQty is number
      && data.stockQty >= 0
      && (data.unit != 'pcs' || data.stockQty is int)
      && data.isActive is bool
      && data.updatedAt == request.time;
    }

    // PRODUCT RULES
    match /products/{productId} {

      // Managers and Cashiers can read products
      allow read: if isStaff();

      // Only Managers can create products
      allow create: if isManager()
        && validProduct(request.resource.data, productId)
        && request.resource.data.isActive == true;

      // Only Managers can edit or archive products
      allow update: if isManager()
        && resource.data.isActive == true
        && validProduct(request.resource.data, productId)
        && (
          (
            request.resource.data.isActive == true
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'name',
                'category',
                'unit',
                'costPrice',
                'sellingPrice',
                'stockQty',
                'updatedAt'
              ])
          )
          ||
          (
            request.resource.data.isActive == false
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'isActive',
                'updatedAt'
              ])
          )
        );

      // Prevent direct deletion
      allow delete: if false;
    }

    // SALES RULES
    match /sales/{saleId} {

      // Only Managers can read sales history
      allow read: if isManager();

      // Sales are created only by the secure
      // server-side checkout API
      allow create, update, delete: if false;
    }
  }
}
